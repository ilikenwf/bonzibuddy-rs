    "name": "\u30de\u30fc\u30ea\u30f3",
    "desc": "\u79c1\u306f\u8ce2\u3044\u9b54\u6cd5\u4f7f\u3044\u3067\u3042\u308b\u3088\u3002\u52a9\u3051\u304c\u5fc5\u8981\u306a\u3089\u3001\u79c1\u3092\u547c\u3073\u306a\u3055\u3044\u3002\u79c1\u306e\u9b54\u6cd5\u3067\u7b54\u3048\u3092\u62ab\u9732\u3059\u308b\u3042\u308b\u3088\u3002",
