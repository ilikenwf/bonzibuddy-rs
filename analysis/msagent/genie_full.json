   {
    "langid": 1025,
    "name": "\u0627\u0644\u062c\u0646\u064a",
    "desc": "\u0623\u0646\u0627 \u062e\u0627\u062f\u0645\u0643 \u0627\u0644\u0645\u062a\u0648\u0627\u0636\u0639 \u0648\u0644\u0643\u0646 \u0627\u0644\u0642\u0648\u064a - \u0623\u0646\u0627 \u062e\u0627\u062f\u0645 \u0627\u0644\u0645\u0635\u0628\u0627\u062d. \u0627\u0633\u062a\u062f\u0639\u0646\u064a \u0643\u064a \u0623\u062d\u0645\u0644 \u0639\u0646\u0643 \u0628\u0639\u0636 \u0623\u0639\u0628\u0627\u0626\u0643.",
    "extra": "\u062e\u0627\u062f\u0645\u0643 \u0648\u0645\u0633\u0627\u0639\u062f\u0643 \u0627\u0644\u0645\u062e\u0644\u0635.^^\u0627\u0639\u0630\u0631\u0646\u064a \u0623\u0644\u0641 \u0645\u0631\u0629 \u064a\u0627 \u0633\u064a\u062f\u064a\u060c \u0648\u0644\u0643\u0646 \u0647\u0627\u0643 \u0623\u0645\u0631 \u062a\u0645\u0646\u064a\u062a \u0645\u0646\u064a \u0623\u0646 \u0623\u0630\u0643\u0651\u0631\u0643 \u0628\u0647."
